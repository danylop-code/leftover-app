{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "leftover-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Active market (brief 21): currency, default shop time zone. "OM" (Oman) or "UA" (Ukraine).
    "MARKET": "OM",
    // Address autocomplete provider (brief 05). komoot's public Photon: free, no key, fair use.
    // Self-host Photon (or switch the adapter in src/services/geo) before real traffic.
    "PHOTON_URL": "https://photon.komoot.io",
    // Browser origins allowed to call the API (the Expo web dev server, brief 17). Comma-separated.
    "CORS_ORIGINS": "http://localhost:8081,http://127.0.0.1:8081"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leftover",
      // Replace with the id from `wrangler d1 create leftover` before first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Shop logos, covers and bag photos (brief 20). `wrangler dev` and the test pool use a local
  // bucket; create the real one with `wrangler r2 bucket create leftover-images` before deploying.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "leftover-images" }]
}
