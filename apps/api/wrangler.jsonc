{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "leftover-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Address autocomplete provider (brief 05). komoot's public Photon: free, no key, fair use.
    // Self-host Photon (or switch the adapter in src/services/geo) before real traffic.
    "PHOTON_URL": "https://photon.komoot.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leftover",
      // Replace with the id from `wrangler d1 create leftover` before first remote deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
