# Base URL of the API Worker. `pnpm dev:api` serves it on port 8787.
# On a physical device use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Market (brief 21): "OM" (Oman: OMR, Asia/Muscat, Muscat seed) or "UA" (Lviv seed, ₴).
# Keep it the same as `MARKET` in apps/api/wrangler.jsonc.
EXPO_PUBLIC_MARKET=OM
